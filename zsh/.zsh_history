: 1736354573:0;FROM alpine:latest\
\
# Install SQLite\
RUN apk add --no-cache sqlite\
\
# Set the working directory\
WORKDIR /app\
\
# Copy SQLite schema file and initialize the database\
COPY schema.sql /app/\
RUN sqlite3 /app/my_database.db < schema.sql\
\
# Start SQLite in interactive mode\
CMD ["sqlite3", "/app/my_database.db"]\

