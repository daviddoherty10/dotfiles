#!/bin/bash

source "$CONFIG_DIR/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

# Catppuccin Mocha: restore the original 40 px bar height for window alignment.
# Reserve the notch area on MacBook displays, leaving content on either side.
sketchybar --bar position=top height=40 notch_display_height=40 notch_width=220 blur_radius=0 color="$BAR_COLOR"

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:15.0"
  label.font="Hack Nerd Font:Bold:13.0"
  background.color="$ITEM_BG_COLOR"
  background.corner_radius=6
  background.height=24
  icon.color="$WHITE"
  label.color="$WHITE"
  icon.padding_left=6
  icon.padding_right=3
  label.padding_left=4
  label.padding_right=8
)
sketchybar --default "${default[@]}"

# A single fixed workspace badge at the far left; update its text on focus.
sketchybar --add event aerospace_workspace_change
sketchybar --add item workspace.current left \
  --set workspace.current \
    icon.drawing=off \
    label="—" \
    background.color="$ACCENT_COLOR" \
    label.color="$BAR_COLOR" \
    script="$PLUGIN_DIR/aerospace.sh" \
  --subscribe workspace.current aerospace_workspace_change

# Keep the current application close to the left screen edge.
sketchybar --add item front_app left \
  --set front_app icon.drawing=off label.max_chars=18 \
    padding_left=3 padding_right=4 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item calendar right \
  --set calendar update_freq=30 script="$PLUGIN_DIR/calendar.sh" \
  --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change \
  --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

source "$ITEM_DIR/cpu.sh"
# Optional lightweight system stat: available RAM (updated every 30 seconds).
sketchybar --add item memory right \
  --set memory icon="RAM" update_freq=30 label="—" script="sh $PLUGIN_DIR/memory.sh"
# All widgets use the right section; the centre remains empty.

# Initialize widget labels and focused workspace.
sketchybar --update
if command -v aerospace >/dev/null 2>&1; then
  sketchybar --trigger aerospace_workspace_change \
    "FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)"
fi
